# Normalize all text files to LF on check-in, checkout as-is on all platforms.
# This keeps the repo consistent between Windows and Linux/macOS and prevents
# noisy diffs from CRLF/LF mismatches.
#
# Git attribute precedence: later lines override earlier ones, so the
# catch-all `*` goes FIRST and specific rules come after.

# Catch-all: auto-detect text files, normalize to LF
* text=auto eol=lf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.apk binary
*.aab binary
*.exe binary
*.msi binary
*.zip binary
*.keystore binary
*.jks binary
*.p12 binary
*.pfx binary
*.pem binary
*.key binary
*.db binary
*.sqlite binary

# Source files — explicit text + LF
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.groovy text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sq text eol=lf
*.sqm text eol=lf

# Shell scripts must stay LF (bash on Linux/macOS)
*.sh text eol=lf

# PowerShell scripts
*.ps1 text eol=lf

# Batch files must stay CRLF (cmd.exe on Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# git diff treats Kotlin as text
*.kt text diff
*.kts text diff